# McDonald's Videogame: mouse-only and known to request an unscaled stage.
# TrimUI Brick uses D-pad mouse because the device has no analog sticks.
name=McDonald's Videogame
aliases=mcdonalds-videogame|mcdonald-s-video-game|mcdonalds-video-game
engine=adaptive
force_scale=showall
mouse_mode=mouse
mouse_click=a

dpad_up=none
dpad_down=none
dpad_left=none
dpad_right=none
south=none
east=none
west=none
north=none
start=none
select=none
left_trigger=none
right_trigger=none
