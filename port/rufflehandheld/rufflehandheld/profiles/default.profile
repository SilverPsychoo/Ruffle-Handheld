# Generic hybrid Flash profile for frozen Native frontend.
# Hybrid default: A=Space and R1 is the mouse click.
name=Generic Flash
aliases=generic|default
mouse_click=r1

dpad_up=38
dpad_down=40
dpad_left=37
dpad_right=39
south=32
east=90
west=88
north=67
start=13
select=27
left_trigger=16
right_trigger=none
